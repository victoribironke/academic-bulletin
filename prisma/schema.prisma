// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  PROGRAMME_COORDINATOR
  HOD
  DEAN
  ADMIN
  SUPER_ADMIN
}

enum SubmissionStatus {
  DRAFT
  CORRECTIONS_REQUIRED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CommentType {
  SUGGESTION
  ISSUE
  QUESTION
  APPROVAL
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum StaffType {
  ACADEMIC
  ADJUNCT
  NON_ACADEMIC
}

enum CourseStatus {
  CORE
  ELECTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum Title {
  MR
  MRS
  MS
  DR
  PROF
  ENGR
  BARR
  REV
  PASTOR
}

enum AcademicQualification {
  PHD
  MASTERS
  BACHELOR
  HND
  OND
}

enum AcademicRank {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  SENIOR_LECTURER
  LECTURER_I
  LECTURER_II
  ASSISTANT_LECTURER
  GRADUATE_ASSISTANT
  OTHER // For non-academic staff with custom job titles
}

enum CourseType {
  GENERAL // Apply to everyone except originating dept
  CORE // Department-specific core courses
  ELECTIVE // Department electives
  REQUIRED // Imposed by other departments
  GST_NUC // GST created by NUC
  GST_BU // BU GSTs created by VAPOC
}

enum CourseOwnership {
  DEPARTMENT // Created and owned by a department
  SCHOOL // Shared at school level
  INSTITUTIONAL // University-wide GST courses
}

enum GraceStatus {
  PENDING
  CHECKING
  COMPLIANT
  NEEDS_REVISION
  ERROR
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================================

model School {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  description  String?
  // E4: the Dean's title, name and photo, kept once for every programme in the school.
  deanTitle    String?
  deanName     String?
  deanImageUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  departments   Department[]
  users         User[]
  masterCourses MasterCourse[] @relation("SchoolCourses") // Courses owned at school level

  @@map("schools")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  // E4: the Head of Department's title, name and photo, kept once for every programme in the department.
  hodTitle    String?
  hodName     String?
  hodImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  schoolId String

  // Relations
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programmes    Programme[]
  users         User[]
  staff         Staff[]
  masterCourses MasterCourse[] @relation("OwnedCourses") // Courses owned by this dept

  @@unique([name, schoolId])
  @@map("departments")
}

model Programme {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  degreeType  String? // e.g., "B.Sc.", "B.Eng.", "MBBS" (code standard, section 1.1)
  duration    Int? // Duration in years
  /// Kept from Heads of Department until DAP confirms it is still offered (task B15).
  isHidden    Boolean  @default(false)
  /// Newly approved, with no page in the 2023-2027 bulletin (task B18).
  isNew       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  submissions      Submission[]
  programmeCourses ProgrammeCourse[] // Courses linked to this programme
  userAssignments  UserProgramme[]

  @@unique([name, departmentId])
  @@map("programmes")
}

// ============================================================================
// CYCLE CALENDAR (task C1, work order section 4)
// Dates are calendar dates in the cycle's time zone (West Africa Time); a
// deadline is the end of the cycle's due time (11:59 pm) on its date.
// ============================================================================

model CyclePhase {
  id              String    @id @default(cuid())
  cycleId         String
  phase           Int
  name            String
  label           String
  /// PROGRAMME (phases 1 to 5, programme by programme) or CYCLE (6 to 10)
  scope           String
  /// HOD, DEAN, DAP_OFFICER, REGISTRY or PRESS
  desk            String
  opensAt         DateTime? @db.Date
  formalOpensAt   DateTime? @db.Date
  targetAt        DateTime? @db.Date
  dueAt           DateTime? @db.Date
  /// Phases 7 to 9 are re-planned from the Senate vote (task C7).
  anchor          String?
  baselineOpensAt DateTime? @db.Date
  baselineDueAt   DateTime? @db.Date
  hardStop        Boolean   @default(false)

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, phase])
  @@map("cycle_phases")
}

model CycleCheckpoint {
  id       String    @id @default(cuid())
  cycleId  String
  phase    Int
  code     String
  name     String
  /// CHECKPOINT (work is checked) or MILESTONE (a date to know)
  type     String    @default("CHECKPOINT")
  dueAt    DateTime  @db.Date
  targetAt DateTime? @db.Date
  sections Int[]     @default([])
  requires String[]  @default([])
  /// Desks it applies to; empty means the phase's desk.
  desks    String[]  @default([])
  hardStop Boolean   @default(false)

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, code])
  @@map("cycle_checkpoints")
}

/// A later date for one department, programme or person. It always takes
/// precedence over the cycle's date (task C1).
model CycleExtension {
  id             String   @id @default(cuid())
  cycleId        String
  /// DEPARTMENT, PROGRAMME or USER
  scope          String
  targetId       String
  /// The phase whose due date moves, or a checkpoint code.
  phase          Int?
  checkpointCode String?
  newDueAt       DateTime @db.Date
  reason         String
  approvedById   String
  createdAt      DateTime @default(now())

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, targetId])
  @@map("cycle_extensions")
}

model CycleHoliday {
  id      String   @id @default(cuid())
  cycleId String
  date    DateTime @db.Date
  name    String

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, date])
  @@map("cycle_holidays")
}

/// No reminders, and no working days, between these dates (inclusive).
model CycleQuietPeriod {
  id       String   @id @default(cuid())
  cycleId  String
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  label    String

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("cycle_quiet_periods")
}

/// Task H8: DAP's online clinics for Heads of Department. Each row is one
/// weekly slot with its joining link, shown on the home page until
/// `untilDate`; no clinic falls on a holiday or in a quiet period.
model CycleClinic {
  id        String   @id @default(cuid())
  cycleId   String
  /// MON to FRI, or SUN (never the Sabbath)
  weekday   String
  /// "HH:MM", West Africa Time
  startTime String
  minutes   Int      @default(30)
  title     String
  joinUrl   String
  /// The last day the clinic runs (Friday, January 29, 2027 by default)
  untilDate DateTime @db.Date
  createdAt DateTime @default(now())

  cycle ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_clinics")
}

/// An old school, department or programme code kept findable after the code
/// standard of November 23, 2026 (task A5). Uploads that use it are accepted
/// with a warning naming the new code until `validUntil` (end of
/// Departmental Drafting, February 4, 2027).
model CodeAlias {
  id         String   @id @default(cuid())
  kind       String // SCHOOL, DEPARTMENT or PROGRAMME
  oldCode    String
  newCode    String
  entityId   String
  validUntil DateTime
  createdAt  DateTime @default(now())

  @@unique([kind, oldCode])
  @@index([entityId])
  @@map("code_aliases")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id        String   @id
  email     String   @unique
  firstName String
  lastName  String
  role      UserRole @default(HOD)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // From the roster (tasks D1, D2): "Prof.", "Dr."; WhatsApp number; acting in the role.
  title         String?
  whatsapp      String?
  isActing      Boolean   @default(false)
  // Invitations and sign-in (task D3).
  invitedAt     DateTime?
  firstSignInAt DateTime?
  lastActiveAt  DateTime?

  // A personal (non-babcock.edu.ng) Google account signs in only while a
  // Super Admin's exception lasts, and never in an admin role.
  signInExceptionUntil       DateTime?
  signInExceptionReason      String?
  signInExceptionGrantedById String?
  signInExceptionGrantedBy   User?     @relation("SignInExceptionGrants", fields: [signInExceptionGrantedById], references: [id], onDelete: SetNull)
  signInExceptionsGranted    User[]    @relation("SignInExceptionGrants")

  // Two-step verification (authenticator app) for Academic Planning Admins
  // and Super Admins. The secret is encrypted with MFA_ENCRYPTION_KEY; until
  // mfaEnabledAt is set it belongs to a set-up nobody has confirmed yet.
  // mfaLastUsedStep is the last accepted 30-second step, so a code can't be
  // used twice.
  mfaSecret         String?
  mfaEnabledAt      DateTime?
  mfaLastUsedStep   Int?
  mfaRecoveryCodes  MfaRecoveryCode[]
  mfaVerifications  MfaVerification[]
  mfaTrustedDevices MfaTrustedDevice[]

  // Foreign Keys (optional - user may be linked to school/department)
  schoolId     String?
  departmentId String?

  // Relations
  school     School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Submissions created by this user
  submissions             Submission[]
  // Phase transitions performed by this user
  phaseTransitions        PhaseTransition[]
  // Comments made by this user
  comments                Comment[]
  courseListConfirmations CourseListConfirmation[]
  courseChangeRequests    CourseChangeRequest[]    @relation("CourseChangeRequester")
  courseChangesResolved   CourseChangeRequest[]    @relation("CourseChangeResolver")
  dapQuestionsAsked       DapQuestion[]            @relation("DapQuestionAsker")
  dapQuestionsAssigned    DapQuestion[]            @relation("DapQuestionOfficer")
  dapQuestionsAnswered    DapQuestion[]            @relation("DapQuestionAnswerer")
  agentMessages           AgentMessage[]           @relation("AgentMessageRecipient")
  checkAcceptances        CheckAcceptance[]
  // Cycles created by this admin
  reviewCycles            ReviewCycle[]
  programmeAssignments    UserProgramme[]
  activities              ActivityLog[]
  // Records this user deleted into the Archive
  archivedRecords         ArchivedRecord[]
  // Review phases this user owns by name, beyond what their role grants
  phaseOwnerships         PhaseOwner[]

  @@map("users")
}

// Programme coordinators may be assigned to one or more programmes while
// keeping a single system role. HODs continue to cover their whole department.
model UserProgramme {
  id          String   @id @default(cuid())
  userId      String
  programmeId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([userId, programmeId])
  @@index([programmeId])
  @@map("user_programmes")
}

// Append-only record of important actions. This is intentionally separate
// from workflow transitions so Academic Planning can audit administrative,
// content, staff, course, and account activity in one place.
model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  actorId     String?
  /// The cycle the entry belongs to (task A4): its draft's or cycle's own,
  /// or the cycle running when it happened. Empty when no cycle was running.
  cycleId     String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([cycleId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("activity_logs")
}

// ============================================================================
// STAFF DIRECTORY (per department, shared across submissions)
// ============================================================================

model Staff {
  id                   String                @id @default(cuid())
  title                Title // Required: Mr., Mrs., Dr., Prof., etc.
  gender               Gender // Required
  surname              String // Required
  middleName           String? // Optional
  firstName            String // Required
  highestQualification AcademicQualification // Required: PHD, MASTERS, etc.
  academicRank         AcademicRank // Required: PROFESSOR, SENIOR_LECTURER, etc.
  customJobTitle       String? // Used when academicRank is OTHER (for non-academic staff)
  specialization       String?
  email                String?
  imageUrl             String? // Staff photo URL (Google Drive or direct link)
  imageDriveFileId     String? // Google Drive file ID for cleanup
  type                 StaffType             @default(ACADEMIC)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("staff")
}

// ============================================================================
// SUBMISSION WORKFLOW
// ============================================================================

model ReviewCycle {
  id                String    @id @default(cuid())
  name              String // e.g., "2025/2026 Bulletin Review"
  description       String?
  isActive          Boolean   @default(true)
  startedAt         DateTime  @default(now())
  closedAt          DateTime?
  /// "Submit to School" stays off before this moment (task F0); empty means no limit.
  submissionsOpenAt DateTime?
  /// Calendar settings (task C1, work order section 4.6).
  bulletinPeriod    String?
  timezone          String    @default("Africa/Lagos")
  defaultDueTime    String    @default("23:59")
  workingWeek       String[]  @default(["MON", "TUE", "WED", "THU", "FRI"])
  /// { weekdays: "18:00-08:00", sabbath: "Friday 18:00 to Saturday 19:00" }
  quietHours        Json?
  /// Task A2 (DEC5): an archived cycle keeps its drafts, comments, photos and
  /// log entries where they are, read-only, and is left out of every
  /// dashboard, count and default view until it is restored.
  isTest            Boolean   @default(false)
  archivedAt        DateTime?
  archivedById      String?
  createdById       String

  createdBy    User               @relation(fields: [createdById], references: [id])
  submissions  Submission[]
  phases       CyclePhase[]
  checkpoints  CycleCheckpoint[]
  extensions   CycleExtension[]
  holidays     CycleHoliday[]
  quietPeriods CycleQuietPeriod[]
  clinics      CycleClinic[]

  @@map("review_cycles")
}

model Submission {
  id                         String           @id @default(cuid())
  title                      String
  currentPhase               Int              @default(1) // Phase 1-10
  status                     SubmissionStatus @default(DRAFT)
  submittedAt                DateTime?
  approvedAt                 DateTime?
  /// Registry courses the department removed from this draft, so a later
  /// Registry upload doesn't put them back (task G6).
  dismissedRegistryCourseIds String[]         @default([])
  /// When the Dean first opened it at School Board Harmonisation; until then
  /// the department can recall it (task D5). Cleared on each submission.
  openedByDeanAt             DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  // Foreign Keys
  programmeId String
  createdById String
  cycleId     String?

  // Relations
  programme              Programme               @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  createdBy              User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cycle                  ReviewCycle?            @relation(fields: [cycleId], references: [id])
  content                SubmissionContent?
  phaseTransitions       PhaseTransition[]
  comments               Comment[]
  courses                Course[]
  courseDescriptions     CourseDescription[]
  courseListConfirmation CourseListConfirmation?
  courseChangeRequests   CourseChangeRequest[]
  dapQuestions           DapQuestion[]
  checkAcceptances       CheckAcceptance[]
  electiveGroups         ElectiveGroup[]

  @@unique([programmeId, cycleId])
  @@map("submissions")
}

// ============================================================================
// SUBMISSION CONTENT (Structured Sections)
// ============================================================================

model SubmissionContent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  submissionId String @unique

  // Section 1: Programme Info (structured)
  programmeInfo Json? // { schoolName, deanName, deptName, hodName, coordinator, overview }

  // Section 2: Philosophy & Objectives (structured with word count validation)
  philosophy          String? // 150-250 words
  philosophyGracePass Boolean @default(false)
  philosophyGrace     Json? // { scores: {G,R,A,C,E}, explanation, recommendation }
  mission             String? // Programme mission statement
  vision              String? // Programme vision statement
  objectives          Json? // Array of objective strings
  uniqueFeatures      Json? // Array of feature strings
  employability       String?
  centurySkills       Json? // Array of 21st century skills

  // Section 3: Admission Requirements (structured)
  utmeRequirements        String?
  directEntryRequirements String?
  transferRequirements    String?
  minimumDuration         String?

  // Section 4: Graduation Requirements (structured)
  graduationRequirements String?
  minimumCGPA            Float?
  totalUnits             Int?
  creditDistribution     Json? // { level100: {sem1: x, sem2: y}, level200: {...}, ... }

  // Section 5: Approvals (structured)
  approvals Json? // { coordinator: {name, date, signature}, hod: {...}, dean: {...} }

  // Legacy sections (kept for backward compatibility)
  sectionA Json?
  sectionB Json?
  sectionC Json?
  sectionD Json?
  sectionE Json?
  sectionF Json?
  sectionG Json?
  sectionH Json?

  /// E2: fields carried over from the 2023-2027 bulletin that the Head has
  /// not yet edited or marked reviewed (rule V18).
  carriedFields String[] @default([])

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_contents")
}

// ============================================================================
// COURSE STRUCTURE (per submission, per level)
// ============================================================================

model Course {
  id             String       @id @default(cuid())
  code           String // e.g., "COS 101"
  title          String // e.g., "Introduction to Computing Sciences" - sentence case
  units          Int // Credit units, 0 to 12 (task B13)
  status         CourseStatus @default(CORE) // Core or Elective
  semester       Int? // 1 or 2; empty for a sessional course with no semester (B13, rule W17)
  level          Int // 100, 200, 300, 400
  prerequisites  String? // Display string for prerequisites
  lectureHours   Int? // W2: lecture hours a semester; units = lecture hours / 15 + practical hours / 45
  practicalHours Int? // W2
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  submissionId    String
  masterCourseId  String? // Link to centralized master course
  electiveGroupId String? // W3: the named group an elective belongs to

  // Relations
  submission    Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  masterCourse  MasterCourse?      @relation(fields: [masterCourseId], references: [id], onDelete: SetNull)
  electiveGroup ElectiveGroup?     @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  description   CourseDescription?

  @@unique([code, submissionId])
  @@unique([title, submissionId])
  @@map("courses")
}

/// W3: electives belong to a named group; a student chooses at least
/// `chooseUnits` units from it, and the totals count that minimum.
model ElectiveGroup {
  id           String   @id @default(cuid())
  submissionId String
  name         String
  chooseUnits  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  courses    Course[]

  @@unique([submissionId, name])
  @@map("elective_groups")
}

// ============================================================================
// COURSE DESCRIPTIONS
// ============================================================================

model CourseDescription {
  id                    String      @id @default(cuid())
  learningOutcomes      Json? // Array of learning outcome strings
  courseContent         String? // Rich text content
  labWork               String? // Lab work description (if applicable)
  entrepreneurialAspect String? // Entrepreneurial/practical aspect of the course
  gracePass             Boolean     @default(false)
  graceResult           Json? // { scores: {G,R,A,C,E}, explanation, recommendation, suggestedContent }
  graceStatus           GraceStatus @default(PENDING)
  graceContentHash      String?
  graceCheckedAt        DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Foreign Keys
  submissionId String
  courseId     String @unique

  // Relations
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  graceAssessment GraceAssessment? @relation(fields: [graceContentHash], references: [contentHash], onDelete: SetNull)

  @@index([submissionId, graceStatus])
  @@index([graceContentHash])
  @@map("course_descriptions")
}

// Counts calls to the AI endpoints per person in fixed windows, so a person
// (or a script using their session) can't run up the AI bill. One row per
// person, endpoint and window; the daily job removes expired rows.
// One-time codes for signing in without the authenticator app. Only a keyed
// hash of each code is stored.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// A code accepted for one sign-in (the session's random id). An admin's
// session works only while its check is under 12 hours old; deleting the
// rows ends those sessions' admin access at once.
/// A browser the person ticked "Remember this device for 30 days" on (task
/// D11). The cookie holds the token; only its SHA-256 hash is kept here.
/// Resetting someone's two-step verification forgets all their devices.
model MfaTrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_trusted_devices")
}

model MfaVerification {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String   @unique
  method     String // "AUTHENTICATOR", "RECOVERY_CODE" or "TRUSTED_DEVICE"
  verifiedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_verifications")
}

model ApiRateLimit {
  key       String   @id // "<limit name>:<user id>:<window number>"
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("api_rate_limits")
}

// Records removed with "Delete". Only a record nothing else depends on can be
// deleted, and it is kept here whole, so an administrator can restore it from
// the Archive page with the same id.
model ArchivedRecord {
  id           String   @id @default(cuid())
  // REVIEW_CYCLE, SCHOOL, DEPARTMENT, PROGRAMME, MASTER_COURSE or STAFF
  entityType   String
  entityId     String
  // What the record was called, shown on the Archive page
  label        String
  // The record as it was when deleted
  data         Json
  archivedById String?
  archivedAt   DateTime @default(now())

  archivedBy User? @relation(fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([archivedAt])
  @@map("archived_records")
}

// Shared by every unchanged copy of the same Registry, CCMAS, GST, uploaded,
// or manually entered course description.
model GraceAssessment {
  contentHash      String      @id
  title            String
  courseContent    String
  learningOutcomes Json?
  status           GraceStatus @default(PENDING)
  result           Json?
  error            String?
  attempts         Int         @default(0)
  checkedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  courseDescriptions CourseDescription[]

  @@index([status, createdAt])
  @@map("grace_assessments")
}

// ============================================================================
// AUDIT TRAIL - Phase Transitions
// ============================================================================

// The workflow ledger: one row per change of a bulletin's phase or status,
// written in the same transaction as the change. Rows are never updated or
// deleted; the database refuses both (see the ledger guard migration).
model PhaseTransition {
  id             String    @id @default(cuid())
  fromPhase      Int
  toPhase        Int
  action         String // e.g., "APPROVED", "RETURNED", "ESCALATED"
  remarks        String?
  transitionedAt DateTime  @default(now())
  // No longer written; daily summaries are tracked in
  // phase_transition_notifications. Kept until a cleanup migration drops it.
  notifiedAt     DateTime?
  // Evidence a phase requires to close, e.g. the Senate minute reference
  reference      String?
  // The role the person acted in (null on rows from before it was recorded)
  actorRole      UserRole?
  // Fingerprint of the bulletin's content at this moment: the text version
  // that was sent on, approved or returned
  contentHash    String?
  // Set when an approval went ahead although GRACE results hadn't passed:
  // the reason given and the results it covered (lib/submissions/grace-gate.ts)
  graceOverride  Json?
  // Set when someone acted on a phase they do not own (task D4): the reason
  // given and the role they acted in. Flagged on the programme and in the log.
  phaseOverride  Json?

  // Foreign Keys
  submissionId  String
  performedById String

  // Relations
  submission   Submission                   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  performedBy  User                         @relation(fields: [performedById], references: [id], onDelete: Restrict)
  notification PhaseTransitionNotification?

  @@index([notifiedAt, transitionedAt])
  @@index([transitionedAt])
  @@index([submissionId, toPhase, transitionedAt])
  @@map("phase_transitions")
}

// When a ledger row was included in a daily summary email. Kept apart from
// the ledger so its rows never change.
model PhaseTransitionNotification {
  transitionId String   @id
  notifiedAt   DateTime @default(now())

  transition PhaseTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

  @@map("phase_transition_notifications")
}

// Who may act on a bulletin at each review phase. A row names either a role
// (its usual scope applies: department roles their department, Deans their
// school, administrators everywhere) or a single user, who may then act on
// every bulletin at that phase. Kept as data so phase owners can change, for
// example when Phases 6 to 9 are assigned, without a code change.
model PhaseOwner {
  id        String    @id @default(cuid())
  phase     Int
  role      UserRole?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phase, role])
  @@unique([phase, userId])
  @@map("phase_owners")
}

// ============================================================================
// COMMENTS / FEEDBACK
// ============================================================================

model Comment {
  id         String        @id @default(cuid())
  content    String
  section    String? // Which section the comment refers to
  phase      Int // Phase at which the comment was made
  type       CommentType   @default(SUGGESTION)
  status     CommentStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Foreign Keys
  submissionId String
  authorId     String

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("comments")
}

// ============================================================================
// MASTER COURSE REGISTRY (Centralized courses for cross-department sharing)
// ============================================================================

model MasterCourse {
  id                    String          @id @default(cuid())
  code                  String          @unique // e.g., "COS 101"
  title                 String // Sentence case enforced programmatically
  units                 Int // 0 to 12 (task B13)
  type                  CourseType      @default(CORE)
  ownership             CourseOwnership @default(DEPARTMENT)
  level                 Int // 100, 200, 300, 400, 500, 600
  semester              Int? // 1 or 2; empty for a sessional course with no semester (B13, rule W17)
  description           String? // Short Registry summary
  learningOutcomes      Json? // Central starting outcomes for GST/shared courses
  courseContent         String? // Central starting course description/content
  labWork               String?
  entrepreneurialAspect String?
  curriculumSource      String? // e.g. CCMAS 2023 or university-developed
  sourceReference       String? // Official document title, URL, or version
  sourceProgrammes      Json? // Programme names used in the source catalogue
  discoverable          Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Ownership - one of these should be set based on ownership type
  ownerDeptId   String?
  ownerSchoolId String?

  // Relations
  ownerDepartment Department? @relation("OwnedCourses", fields: [ownerDeptId], references: [id], onDelete: SetNull)
  ownerSchool     School?     @relation("SchoolCourses", fields: [ownerSchoolId], references: [id], onDelete: SetNull)

  // Which programmes use this course
  programmeLinks ProgrammeCourse[]

  // Submission courses that reference this master
  submissionCourses Course[]

  // Self-referential for prerequisites
  prerequisites  MasterCourse[] @relation("Prerequisites")
  prerequisiteOf MasterCourse[] @relation("Prerequisites")

  @@map("master_courses")
}

// ============================================================================
// PROGRAMME-COURSE JUNCTION (Links programmes to master courses)
// ============================================================================

model ProgrammeCourse {
  id                       String      @id @default(cuid())
  isCore                   Boolean     @default(true) // Core for THIS specific programme
  titleOverride            String?
  unitsOverride            Int?
  typeOverride             CourseType?
  semesterOverride         Int?
  levelOverride            Int? // B14: this programme's level when it differs from the Registry's
  learningOutcomesOverride Json?
  courseContentOverride    String?
  sourceProgrammeName      String?
  sourceReference          String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  // Foreign Keys
  programmeId String
  courseId    String

  // Relations
  programme Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  course    MasterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programmeId, courseId])
  @@map("programme_courses")
}

/// The Academic Policy library (task H9): versions DAP uploads. Without
/// one, the app shows the policy bundled with it (data/policy). Earlier
/// versions stay readable.
model PolicyVersion {
  id           String   @id @default(cuid())
  /// e.g. "Updated September 8, 2025"
  label        String
  /// Shown above the text, e.g. that the policy is under review.
  note         String?
  /// Where it came from, e.g. the Word file Senate voted.
  sourceName   String?
  /// The whole policy as markdown; split into sections when read.
  content      String
  isCurrent    Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("policy_versions")
}

// ============================================================================
// COURSE LIST CONFIRMATION AND CHANGE REQUESTS (task B10)
// ============================================================================

/// The Head of Department confirmed the programme's course list (B10). The
/// fingerprint of the list at that moment shows when it changed afterwards.
model CourseListConfirmation {
  id            String   @id @default(cuid())
  submissionId  String   @unique
  confirmedById String
  confirmedAt   DateTime @default(now())
  courseCount   Int
  fingerprint   String

  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  confirmedBy User       @relation(fields: [confirmedById], references: [id], onDelete: Restrict)

  @@map("course_list_confirmations")
}

/// A Head of Department asks DAP to change the course list: add or remove a
/// course, or change its units or semester (B10). DAP's queue lists them.
model CourseChangeRequest {
  id            String    @id @default(cuid())
  submissionId  String
  // ADD, REMOVE, UNITS, SEMESTER or OTHER
  kind          String
  courseCode    String?
  details       String
  // OPEN, DONE or DECLINED
  status        String    @default("OPEN")
  response      String?
  requestedById String
  requestedAt   DateTime  @default(now())
  resolvedById  String?
  resolvedAt    DateTime?

  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("CourseChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy  User?      @relation("CourseChangeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([submissionId])
  @@map("course_change_requests")
}

// ============================================================================
// ASK DAP (task H6)
// ============================================================================

/// A question about one section or field of a draft, for the DAP officer of
/// the programme's school, who aims to answer within one working day (H6).
model DapQuestion {
  id           String    @id @default(cuid())
  submissionId String
  // The draft section ("overview") and, when given, the field ("philosophy")
  section      String
  field        String?
  question     String
  // OPEN or ANSWERED
  status       String    @default("OPEN")
  answer       String?
  askedById    String
  askedAt      DateTime  @default(now())
  // One working day after it was asked
  dueAt        DateTime
  officerId    String?
  answeredById String?
  answeredAt   DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  askedBy    User       @relation("DapQuestionAsker", fields: [askedById], references: [id], onDelete: Restrict)
  officer    User?      @relation("DapQuestionOfficer", fields: [officerId], references: [id], onDelete: SetNull)
  answeredBy User?      @relation("DapQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([submissionId])
  @@map("dap_questions")
}

// ============================================================================
// REMINDER AGENT (tasks T3 to T6)
// ============================================================================

/// One message from the reminder agent to one desk on one day (T3): prepared
/// at 7:00 am WAT, held for DAP to read, sent at 8:00 am. Kept for good, with
/// the facts it used (T5).
model AgentMessage {
  id          String    @id @default(cuid())
  /// "HOD:<user id>": the desk the message is for
  deskKey     String
  recipientId String
  /// Supervisors and DAP leadership copied (T4)
  ccIds       String[]  @default([])
  forDate     DateTime  @db.Date
  /// PREPARED, HELD, SENT, SKIPPED or FAILED
  status      String    @default("PREPARED")
  subject     String
  body        String
  reasons     String[]  @default([])
  facts       Json
  /// AI or TEMPLATE
  writtenBy   String
  editedById  String?
  preparedAt  DateTime  @default(now())
  sentAt      DateTime?
  error       String?

  recipient User @relation("AgentMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([deskKey, forDate])
  @@index([forDate, status])
  @@index([recipientId, sentAt])
  @@map("agent_messages")
}

/// DAP's controls for the agent (T5): "sending" (on or off), "pause:ALL",
/// and "pause:<desk key>" for one desk.
model AgentControl {
  key         String   @id
  value       String
  reason      String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("agent_controls")
}

/// F1: a "Please check" the person accepted, with their reason. The key names
/// the check and what it is about (for example "V3:200:1" for 200 level,
/// first semester), so a new problem of the same kind is shown again.
model CheckAcceptance {
  id           String   @id @default(cuid())
  submissionId String
  checkKey     String
  reason       String
  acceptedById String?
  acceptedAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  acceptedBy User?      @relation(fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([submissionId, checkKey])
  @@map("check_acceptances")
}
