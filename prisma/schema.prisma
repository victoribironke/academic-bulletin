// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  COORDINATOR
  HOD
  DEAN
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CommentType {
  SUGGESTION
  ISSUE
  QUESTION
  APPROVAL
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum StaffType {
  ACADEMIC
  ADJUNCT
  NON_ACADEMIC
}

enum CourseStatus {
  CORE
  ELECTIVE
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================================

model School {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  departments Department[]
  users       User[]

  @@map("schools")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  schoolId String

  // Relations
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programmes Programme[]
  users      User[]
  staff      Staff[]

  @@unique([name, schoolId])
  @@map("departments")
}

model Programme {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  degreeType  String? // e.g., "BSc", "MSc", "PhD"
  duration    Int? // Duration in years
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([name, departmentId])
  @@map("programmes")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(COORDINATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign Keys (optional - user may be linked to school/department)
  schoolId     String?
  departmentId String?

  // Relations
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Submissions created by this user
  submissions       Submission[]
  // Phase transitions performed by this user
  phaseTransitions  PhaseTransition[]
  // Comments made by this user
  comments          Comment[]

  @@map("users")
}

// ============================================================================
// STAFF DIRECTORY (per department, shared across submissions)
// ============================================================================

model Staff {
  id             String    @id @default(cuid())
  name           String
  position       String    // e.g., "Professor", "Senior Lecturer", "Lab Technologist"
  specialization String?
  email          String?
  type           StaffType @default(ACADEMIC)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses    Course[]   // Courses this staff member teaches

  @@map("staff")
}

// ============================================================================
// SUBMISSION WORKFLOW
// ============================================================================

model Submission {
  id           String           @id @default(cuid())
  title        String
  academicYear String // e.g., "2025/2026"
  currentPhase Int              @default(1) // Phase 1-11
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Foreign Keys
  programmeId String
  createdById String

  // Relations
  programme          Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  content            SubmissionContent?
  phaseTransitions   PhaseTransition[]
  comments           Comment[]
  courses            Course[]
  courseDescriptions CourseDescription[]

  @@unique([programmeId, academicYear])
  @@map("submissions")
}

// ============================================================================
// SUBMISSION CONTENT (Structured Sections)
// ============================================================================

model SubmissionContent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  submissionId String @unique

  // Section 1: Programme Info (structured)
  programmeInfo Json? // { schoolName, deanName, deptName, hodName, coordinator, overview }

  // Section 2: Philosophy & Objectives (structured with word count validation)
  philosophy      String? // 150-250 words
  objectives      Json?   // Array of objective strings
  uniqueFeatures  Json?   // Array of feature strings
  employability   String?
  centurySkills   Json?   // Array of 21st century skills

  // Section 3: Admission Requirements (structured)
  utmeRequirements        String?
  directEntryRequirements String?
  transferRequirements    String?
  minimumDuration         String?

  // Section 4: Graduation Requirements (structured)
  graduationRequirements String?
  minimumCGPA            Float?
  totalUnits             Int?
  creditDistribution     Json? // { level100: {sem1: x, sem2: y}, level200: {...}, ... }

  // Section 5: Approvals (structured)
  approvals Json? // { coordinator: {name, date, signature}, hod: {...}, dean: {...} }

  // Legacy sections (kept for backward compatibility)
  sectionA Json?
  sectionB Json?
  sectionC Json?
  sectionD Json?
  sectionE Json?
  sectionF Json?
  sectionG Json?
  sectionH Json?

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_contents")
}

// ============================================================================
// COURSE STRUCTURE (per submission, per level)
// ============================================================================

model Course {
  id           String       @id @default(cuid())
  code         String       // e.g., "COS 101"
  title        String       // e.g., "Introduction to Computing Sciences"
  units        Int          // Credit units
  status       CourseStatus @default(CORE) // Core or Elective
  semester     Int          // 1 or 2
  level        Int          // 100, 200, 300, 400
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Foreign Keys
  submissionId String
  lecturerId   String? // Lecturer must be assigned before submission

  // Relations
  submission  Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lecturer    Staff?             @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  description CourseDescription?

  @@unique([code, submissionId])
  @@map("courses")
}

// ============================================================================
// COURSE DESCRIPTIONS
// ============================================================================

model CourseDescription {
  id               String   @id @default(cuid())
  learningOutcomes Json?    // Array of learning outcome strings
  courseContent    String?  // Rich text content
  labWork          String?  // Lab work description (if applicable)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Foreign Keys
  submissionId String
  courseId     String @unique

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_descriptions")
}

// ============================================================================
// AUDIT TRAIL - Phase Transitions
// ============================================================================

model PhaseTransition {
  id            String   @id @default(cuid())
  fromPhase     Int
  toPhase       Int
  action        String // e.g., "APPROVED", "RETURNED", "ESCALATED"
  remarks       String?
  transitionedAt DateTime @default(now())

  // Foreign Keys
  submissionId  String
  performedById String

  // Relations
  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  performedBy User       @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@map("phase_transitions")
}

// ============================================================================
// COMMENTS / FEEDBACK
// ============================================================================

model Comment {
  id         String        @id @default(cuid())
  content    String
  section    String?       // Which section the comment refers to
  phase      Int           // Phase at which the comment was made
  type       CommentType   @default(SUGGESTION)
  status     CommentStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Foreign Keys
  submissionId String
  authorId     String

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("comments")
}

