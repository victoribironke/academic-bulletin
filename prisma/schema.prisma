// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}


// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  PROGRAMME_COORDINATOR
  HOD
  DEAN
  ADMIN
  SUPER_ADMIN
}

enum SubmissionStatus {
  DRAFT
  CORRECTIONS_REQUIRED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CommentType {
  SUGGESTION
  ISSUE
  QUESTION
  APPROVAL
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum StaffType {
  ACADEMIC
  ADJUNCT
  NON_ACADEMIC
}

enum CourseStatus {
  CORE
  ELECTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum Title {
  MR
  MRS
  MS
  DR
  PROF
  ENGR
  BARR
  REV
  PASTOR
}

enum AcademicQualification {
  PHD
  MASTERS
  BACHELOR
  HND
  OND
}

enum AcademicRank {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  SENIOR_LECTURER
  LECTURER_I
  LECTURER_II
  ASSISTANT_LECTURER
  GRADUATE_ASSISTANT
  OTHER // For non-academic staff with custom job titles
}

enum CourseType {
  GENERAL // Apply to everyone except originating dept
  CORE // Department-specific core courses
  ELECTIVE // Department electives
  REQUIRED // Imposed by other departments
  GST_NUC // GST created by NUC
  GST_BU // BU GSTs created by VAPOC
}

enum CourseOwnership {
  DEPARTMENT // Created and owned by a department
  SCHOOL // Shared at school level
  INSTITUTIONAL // University-wide GST courses
}

enum GraceStatus {
  PENDING
  CHECKING
  COMPLIANT
  NEEDS_REVISION
  ERROR
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================================

model School {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  departments   Department[]
  users         User[]
  masterCourses MasterCourse[] @relation("SchoolCourses") // Courses owned at school level

  @@map("schools")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  schoolId String

  // Relations
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programmes    Programme[]
  users         User[]
  staff         Staff[]
  masterCourses MasterCourse[] @relation("OwnedCourses") // Courses owned by this dept

  @@unique([name, schoolId])
  @@map("departments")
}

model Programme {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  degreeType  String? // e.g., "BSc", "MSc", "PhD"
  duration    Int? // Duration in years
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  submissions      Submission[]
  programmeCourses ProgrammeCourse[] // Courses linked to this programme
  userAssignments  UserProgramme[]

  @@unique([name, departmentId])
  @@map("programmes")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id           String   @id
  email        String   @unique
  firstName    String
  lastName     String
  role         UserRole @default(HOD)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign Keys (optional - user may be linked to school/department)
  schoolId     String?
  departmentId String?

  // Relations
  school     School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Submissions created by this user
  submissions      Submission[]
  // Phase transitions performed by this user
  phaseTransitions PhaseTransition[]
  // Comments made by this user
  comments         Comment[]
  // Cycles created by this admin
  reviewCycles     ReviewCycle[]
  programmeAssignments UserProgramme[]
  activities       ActivityLog[]
  // Review phases this user owns by name, beyond what their role grants
  phaseOwnerships  PhaseOwner[]

  @@map("users")
}

// Programme coordinators may be assigned to one or more programmes while
// keeping a single system role. HODs continue to cover their whole department.
model UserProgramme {
  id          String   @id @default(cuid())
  userId      String
  programmeId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([userId, programmeId])
  @@index([programmeId])
  @@map("user_programmes")
}

// Append-only record of important actions. This is intentionally separate
// from workflow transitions so Academic Planning can audit administrative,
// content, staff, course, and account activity in one place.
model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  actorId     String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("activity_logs")
}

// ============================================================================
// STAFF DIRECTORY (per department, shared across submissions)
// ============================================================================

model Staff {
  id                   String                @id @default(cuid())
  title                Title // Required: Mr., Mrs., Dr., Prof., etc.
  gender               Gender // Required
  surname              String // Required
  middleName           String? // Optional
  firstName            String // Required
  highestQualification AcademicQualification // Required: PHD, MASTERS, etc.
  academicRank         AcademicRank // Required: PROFESSOR, SENIOR_LECTURER, etc.
  customJobTitle       String? // Used when academicRank is OTHER (for non-academic staff)
  specialization       String?
  email                String?
  imageUrl             String? // Staff photo URL (Google Drive or direct link)
  imageDriveFileId     String? // Google Drive file ID for cleanup
  type                 StaffType             @default(ACADEMIC)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Foreign Keys
  departmentId String

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("staff")
}

// ============================================================================
// SUBMISSION WORKFLOW
// ============================================================================

model ReviewCycle {
  id          String   @id @default(cuid())
  name        String   // e.g., "2025/2026 Bulletin Review"
  description String?
  isActive    Boolean  @default(true)
  startedAt   DateTime @default(now())
  closedAt    DateTime?
  createdById String

  createdBy   User         @relation(fields: [createdById], references: [id])
  submissions Submission[]

  @@map("review_cycles")
}

model Submission {
  id           String           @id @default(cuid())
  title        String
  currentPhase Int              @default(1) // Phase 1-10
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Foreign Keys
  programmeId String
  createdById String
  cycleId     String?

  // Relations
  programme          Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cycle              ReviewCycle?        @relation(fields: [cycleId], references: [id])
  content            SubmissionContent?
  phaseTransitions   PhaseTransition[]
  comments           Comment[]
  courses            Course[]
  courseDescriptions CourseDescription[]

  @@unique([programmeId, cycleId])
  @@map("submissions")
}

// ============================================================================
// SUBMISSION CONTENT (Structured Sections)
// ============================================================================

model SubmissionContent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  submissionId String @unique

  // Section 1: Programme Info (structured)
  programmeInfo Json? // { schoolName, deanName, deptName, hodName, coordinator, overview }

  // Section 2: Philosophy & Objectives (structured with word count validation)
  philosophy          String? // 150-250 words
  philosophyGracePass Boolean  @default(false)
  philosophyGrace     Json? // { scores: {G,R,A,C,E}, explanation, recommendation }
  mission             String? // Programme mission statement
  vision              String? // Programme vision statement
  objectives     Json? // Array of objective strings
  uniqueFeatures Json? // Array of feature strings
  employability  String?
  centurySkills  Json? // Array of 21st century skills

  // Section 3: Admission Requirements (structured)
  utmeRequirements        String?
  directEntryRequirements String?
  transferRequirements    String?
  minimumDuration         String?

  // Section 4: Graduation Requirements (structured)
  graduationRequirements String?
  minimumCGPA            Float?
  totalUnits             Int?
  creditDistribution     Json? // { level100: {sem1: x, sem2: y}, level200: {...}, ... }

  // Section 5: Approvals (structured)
  approvals Json? // { coordinator: {name, date, signature}, hod: {...}, dean: {...} }

  // Legacy sections (kept for backward compatibility)
  sectionA Json?
  sectionB Json?
  sectionC Json?
  sectionD Json?
  sectionE Json?
  sectionF Json?
  sectionG Json?
  sectionH Json?

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_contents")
}

// ============================================================================
// COURSE STRUCTURE (per submission, per level)
// ============================================================================

model Course {
  id            String       @id @default(cuid())
  code          String // e.g., "COS 101"
  title         String // e.g., "Introduction to Computing Sciences" - sentence case
  units         Int // Credit units
  status        CourseStatus @default(CORE) // Core or Elective
  semester      Int // 1 or 2
  level         Int // 100, 200, 300, 400
  prerequisites String? // Display string for prerequisites
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Foreign Keys
  submissionId   String
  masterCourseId String? // Link to centralized master course

  // Relations
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  masterCourse MasterCourse?      @relation(fields: [masterCourseId], references: [id], onDelete: SetNull)
  description  CourseDescription?

  @@unique([code, submissionId])
  @@unique([title, submissionId])
  @@map("courses")
}

// ============================================================================
// COURSE DESCRIPTIONS
// ============================================================================

model CourseDescription {
  id               String   @id @default(cuid())
  learningOutcomes Json? // Array of learning outcome strings
  courseContent    String? // Rich text content
  labWork              String? // Lab work description (if applicable)
  entrepreneurialAspect String? // Entrepreneurial/practical aspect of the course
  gracePass        Boolean     @default(false)
  graceResult      Json? // { scores: {G,R,A,C,E}, explanation, recommendation, suggestedContent }
  graceStatus      GraceStatus @default(PENDING)
  graceContentHash String?
  graceCheckedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Foreign Keys
  submissionId String
  courseId     String @unique

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  graceAssessment GraceAssessment? @relation(fields: [graceContentHash], references: [contentHash], onDelete: SetNull)

  @@index([submissionId, graceStatus])
  @@index([graceContentHash])
  @@map("course_descriptions")
}

// Shared by every unchanged copy of the same Registry, CCMAS, GST, uploaded,
// or manually entered course description.
model GraceAssessment {
  contentHash      String      @id
  title            String
  courseContent    String
  learningOutcomes Json?
  status           GraceStatus @default(PENDING)
  result           Json?
  error             String?
  attempts          Int         @default(0)
  checkedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  courseDescriptions CourseDescription[]

  @@index([status, createdAt])
  @@map("grace_assessments")
}

// ============================================================================
// AUDIT TRAIL - Phase Transitions
// ============================================================================

// The workflow ledger: one row per change of a bulletin's phase or status,
// written in the same transaction as the change. Rows are never updated or
// deleted; the database refuses both (see the ledger guard migration).
model PhaseTransition {
  id             String   @id @default(cuid())
  fromPhase      Int
  toPhase        Int
  action         String // e.g., "APPROVED", "RETURNED", "ESCALATED"
  remarks        String?
  transitionedAt DateTime @default(now())
  // No longer written; daily summaries are tracked in
  // phase_transition_notifications. Kept until a cleanup migration drops it.
  notifiedAt     DateTime?
  // Evidence a phase requires to close, e.g. the Senate minute reference
  reference      String?
  // The role the person acted in (null on rows from before it was recorded)
  actorRole      UserRole?
  // Fingerprint of the bulletin's content at this moment: the text version
  // that was sent on, approved or returned
  contentHash    String?

  // Foreign Keys
  submissionId  String
  performedById String

  // Relations
  submission   Submission                   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  performedBy  User                         @relation(fields: [performedById], references: [id], onDelete: Restrict)
  notification PhaseTransitionNotification?

  @@index([notifiedAt, transitionedAt])
  @@index([transitionedAt])
  @@index([submissionId, toPhase, transitionedAt])
  @@map("phase_transitions")
}

// When a ledger row was included in a daily summary email. Kept apart from
// the ledger so its rows never change.
model PhaseTransitionNotification {
  transitionId String   @id
  notifiedAt   DateTime @default(now())

  transition PhaseTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

  @@map("phase_transition_notifications")
}

// Who may act on a bulletin at each review phase. A row names either a role
// (its usual scope applies: department roles their department, Deans their
// school, administrators everywhere) or a single user, who may then act on
// every bulletin at that phase. Kept as data so phase owners can change, for
// example when Phases 6 to 9 are assigned, without a code change.
model PhaseOwner {
  id        String    @id @default(cuid())
  phase     Int
  role      UserRole?
  userId    String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phase, role])
  @@unique([phase, userId])
  @@map("phase_owners")
}

// ============================================================================
// COMMENTS / FEEDBACK
// ============================================================================

model Comment {
  id         String        @id @default(cuid())
  content    String
  section    String? // Which section the comment refers to
  phase      Int // Phase at which the comment was made
  type       CommentType   @default(SUGGESTION)
  status     CommentStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Foreign Keys
  submissionId String
  authorId     String

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("comments")
}

// ============================================================================
// MASTER COURSE REGISTRY (Centralized courses for cross-department sharing)
// ============================================================================

model MasterCourse {
  id          String          @id @default(cuid())
  code        String          @unique // e.g., "COS 101"
  title       String // Sentence case enforced programmatically
  units       Int
  type        CourseType      @default(CORE)
  ownership   CourseOwnership @default(DEPARTMENT)
  level       Int // 100, 200, 300, 400, 500
  semester    Int // 1 or 2
  description           String? // Short Registry summary
  learningOutcomes      Json? // Central starting outcomes for GST/shared courses
  courseContent         String? // Central starting course description/content
  labWork               String?
  entrepreneurialAspect String?
  curriculumSource      String? // e.g. CCMAS 2023 or university-developed
  sourceReference       String? // Official document title, URL, or version
  sourceProgrammes      Json? // Programme names used in the source catalogue
  discoverable Boolean @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Ownership - one of these should be set based on ownership type
  ownerDeptId   String?
  ownerSchoolId String?

  // Relations
  ownerDepartment Department? @relation("OwnedCourses", fields: [ownerDeptId], references: [id], onDelete: SetNull)
  ownerSchool     School?     @relation("SchoolCourses", fields: [ownerSchoolId], references: [id], onDelete: SetNull)

  // Which programmes use this course
  programmeLinks ProgrammeCourse[]

  // Submission courses that reference this master
  submissionCourses Course[]

  // Self-referential for prerequisites
  prerequisites  MasterCourse[] @relation("Prerequisites")
  prerequisiteOf MasterCourse[] @relation("Prerequisites")

  @@map("master_courses")
}

// ============================================================================
// PROGRAMME-COURSE JUNCTION (Links programmes to master courses)
// ============================================================================

model ProgrammeCourse {
  id                       String      @id @default(cuid())
  isCore                   Boolean     @default(true) // Core for THIS specific programme
  titleOverride            String?
  unitsOverride            Int?
  typeOverride             CourseType?
  semesterOverride         Int?
  learningOutcomesOverride Json?
  courseContentOverride    String?
  sourceProgrammeName      String?
  sourceReference          String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  // Foreign Keys
  programmeId String
  courseId    String

  // Relations
  programme Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  course    MasterCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programmeId, courseId])
  @@map("programme_courses")
}
