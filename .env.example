# Academic Bulletin — environment variables
#
# Local development: copy this file to .env.local and fill it in.
# Production: add the same variables in Vercel → Project → Settings → Environment Variables.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs → Prisma.
# DATABASE_URL: the pooled "transaction" connection (port 6543), used by the app.
# DIRECT_URL:   the "session" or direct connection (port 5432), used by `bun run db:push`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase (Google sign-in + photo storage) ────────────────────────────────
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── GRACE checks (Gemini) ────────────────────────────────────────────────────
# Google AI Studio → API keys.
GEMINI_API_KEY=
# The model itself is set in lib/site-config.ts.

# ── Workflow emails (Resend) ─────────────────────────────────────────────────
# Resend dashboard → API Keys.
# The site address and "from" address are set in lib/site-config.ts.
RESEND_API_KEY=

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -hex 32`. Protects /api/cron/keep-alive.
CRON_SECRET=

# ── First-time setup only (bun run db:seed) ──────────────────────────────────
# The first Super Admin. They sign in with the Google account for this email.
SEED_SUPER_ADMIN_EMAIL=
