# Academic Bulletin — environment variables
#
# Local development: copy this file to .env.local and fill it in.
# Production: add the same variables in Vercel → Project → Settings → Environment Variables.

# ── Database (Railway Postgres) ──────────────────────────────────────────────
# Railway → Postgres service → Variables → DATABASE_PUBLIC_URL (the app runs on
# Vercel, outside Railway's private network, so use the public URL).
DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway
# Optional: a separate connection for Prisma migrations. Leave unset to use DATABASE_URL.
DIRECT_URL=

# ── Sign-in (Auth.js with Google) ────────────────────────────────────────────
# AUTH_SECRET: any long random string, e.g. `openssl rand -base64 33`.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: https://<site>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local development).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Two-step verification for admins ─────────────────────────────────────────
# Encrypts the authenticator-app secrets. 32 random bytes in base64:
# `openssl rand -base64 32`. Set it before deploying; without it admins can't
# sign in. Keep a copy somewhere safe (a password manager): if it's lost or
# changed, every admin's two-step verification has to be reset.
MFA_ENCRYPTION_KEY=

# ── Photo storage (Railway bucket) ───────────────────────────────────────────
# Railway → bucket → Credentials tab.
STORAGE_ENDPOINT=https://storage.railway.app
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ── GRACE checks (Claude) ────────────────────────────────────────────────────
# Claude Console (platform.claude.com) → API keys.
ANTHROPIC_API_KEY=
# The model itself is set in lib/site-config.ts.

# ── Workflow emails (Resend) ─────────────────────────────────────────────────
# Resend dashboard → API Keys.
# The site address and "from" address are set in lib/site-config.ts.
RESEND_API_KEY=

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -hex 32`. Protects the daily job at /api/cron/daily.
CRON_SECRET=

# ── First-time setup only (bun run db:seed) ──────────────────────────────────
# The first Super Admin. They sign in with the Google account for this email.
SEED_SUPER_ADMIN_EMAIL=
