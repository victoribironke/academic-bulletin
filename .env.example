# === Academic Bulletin (Next.js) ===

# ── PostgreSQL (Local Database) ────────────────────────────────────────────────
# Credentials for your local PostgreSQL instance (created during server setup).
# Generate a strong password with: openssl rand -base64 24
POSTGRES_USER=abrms_user
POSTGRES_PASSWORD=
POSTGRES_DB=abrms_db

# ── Prisma Database Connection ─────────────────────────────────────────────────
# Both URLs point to your LOCAL PostgreSQL — NOT Supabase's database.
# On a local server without PgBouncer, DATABASE_URL and DIRECT_URL are identical.
# sslmode=disable is safe for a local loopback connection.
DATABASE_URL=postgresql://abrms_user:<password>@localhost:5432/abrms_db?sslmode=disable
DIRECT_URL=postgresql://abrms_user:<password>@localhost:5432/abrms_db?sslmode=disable

# ── Supabase (Self-hosted Auth & Storage — Local GoTrue + Storage API) ─────────
#
# Because Supabase is self-hosted (addendum: local GoTrue on :9999, Storage API
# on :5000, both proxied by Apache), these values differ from a cloud Supabase
# project:
#
#   NEXT_PUBLIC_SUPABASE_URL
#       → Set to your server's public domain (or http://SERVER_IP for IP-only).
#         Apache routes /auth/v1/* → GoTrue (:9999) and /storage/v1/* → Storage API (:5000).
#         Do NOT use https://<id>.supabase.co here.
#
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY  (anon key)
#       → A JWT you generated locally in Step A of the addendum (role: "anon").
#         It is NOT the sb_publishable_... key from the Supabase dashboard.
#
#   SUPABASE_SERVICE_ROLE_KEY  (service role key)
#       → A JWT you generated locally in Step A of the addendum (role: "service_role").
#         It is NOT the sb_secret_... key from the Supabase dashboard.
#
# To regenerate these keys, re-run the Python script from addendum Step A.2 with
# your JWT_SECRET. All three services (GoTrue, Storage API, and this app) must
# share the same JWT_SECRET — see /etc/supabase-auth.env and /etc/supabase-storage.env.
#
NEXT_PUBLIC_SUPABASE_URL=https://your_domain.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<anon-jwt-from-step-A>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt-from-step-A>

# === GRACE Vision AI (FastAPI) ===
# Where Next.js calls the local GRACE service. For on-premise deployment, this
# points to the local systemd-managed GRACE service.
GRACE_VISION_SPACE_URL=http://localhost:7860

# At least GOOGLE_API_KEY is required. See deployment guide Section 2.3 for tiers.
GOOGLE_API_KEY=
# TOGETHER_API_KEY=   # Optional Tier 2 fallback
# HF_TOKEN=           # Optional Tier 3 local model fallback (~8 GB RAM required)

# === Runtime ===
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
